{
	"name": "casino-dashboard-frontend",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*.ts",
		"#ui/*": "./src/lib/ui/*.svelte",
		"#components/*": "./src/lib/components/*.svelte"
	},
	"packageManager": "pnpm@12.21.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"gen:api": "openapi-typescript ../contracts/openapi.json -o src/lib/api/schema.ts && prettier --write src/lib/api/schema.ts",
		"test": "vitest run",
		"e2e": "playwright test",
		"budget": "node scripts/bundle-budget.mjs",
		"e2e:stack": "playwright test -c playwright.stack.config.ts",
		"perf": "playwright test -c playwright.perf.config.ts perf/framerate.spec.ts",
		"soak": "playwright test -c playwright.perf.config.ts perf/soak.spec.ts"
	},
	"dependencies": {
		"@xterm/xterm": "^6.0.0",
		"lightweight-charts": "^5.3.0",
		"openapi-fetch": "^0.17.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^24.19.2",
		"eslint": "^10.15.0",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"lighthouse": "^13.6.0",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	}
}
