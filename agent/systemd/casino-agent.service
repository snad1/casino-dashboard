# Installed by agent/install.sh, which fills in @AGENT_DIR@.
[Unit]
Description=Casino dashboard host agent (allowlisted commands for the dashboard api)
After=default.target

[Service]
Type=simple
WorkingDirectory=@AGENT_DIR@
# "+" runs this step outside the sandbox: in a user unit the sandbox maps only the user's own
# ids, so the agent itself cannot give its socket to the casino-agent group. The setgid
# directory does it instead: the socket created in it gets the directory's group.
ExecStartPre=+/bin/sh -c 'chgrp casino-agent "%t/casino-agent" && chmod 2750 "%t/casino-agent"'
ExecStart=@AGENT_DIR@/.venv/bin/python -m agent serve
EnvironmentFile=%h/.config/casino-agent/agent.env
Restart=on-failure
RestartSec=5

# The bots keep the CPU and disk: they run at Nice=-5 with weight 1024.
Nice=10
IOSchedulingClass=idle
CPUWeight=20

RuntimeDirectory=casino-agent
RuntimeDirectoryMode=0750
StateDirectory=casino-agent
UMask=0007
ProtectSystem=strict
# wolfctl and wolfbet.py write the bots' config, state and DB under HOME.
ReadWritePaths=%S/casino-agent %h
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
