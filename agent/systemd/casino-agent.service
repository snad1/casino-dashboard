# Installed by agent/install.sh as a system unit; it fills in @AGENT_DIR@, @CONF_DIR@ and @HOME@.
# A system unit, not --user: the socket lives in /run/casino-agent, which the api bind-mounts.
# install.sh removes any older --user copy, which would crash-loop against this one.
[Unit]
Description=Casino dashboard host agent (allowlisted commands for the dashboard api)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@AGENT_DIR@
ExecStart=@AGENT_DIR@/.venv/bin/python -m agent serve
EnvironmentFile=@CONF_DIR@/agent.env
Restart=on-failure
RestartSec=5

# The bots keep the CPU and disk: they run at Nice=-5 with weight 1024.
Nice=10
IOSchedulingClass=idle
CPUWeight=20

# /run/casino-agent. The agent runs as root, so it gives the socket and this directory to
# the casino-agent group itself; no ExecStartPre is needed.
RuntimeDirectory=casino-agent
RuntimeDirectoryMode=0750
# Kept across restarts: the api bind-mounts this directory, and a recreated one leaves that
# mount pointing at the deleted directory until the api restarts too.
RuntimeDirectoryPreserve=yes
StateDirectory=casino-agent
UMask=0007
ProtectSystem=strict
# wolfctl and wolfbet.py write the bots' config, state and DB under HOME.
ReadWritePaths=/var/lib/casino-agent @HOME@
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
