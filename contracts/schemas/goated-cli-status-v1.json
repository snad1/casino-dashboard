{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "goated-cli-status-v1.json",
  "title": "goated.py --status --json",
  "description": "This lane's live state and whether its daemon pid is alive; goated's state file names the target multiplier_target and adds the dice target and condition. A lane that never ran has no state file: state is null and running false.",
  "oneOf": [
    {
      "$ref": "#/$defs/ok"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "ok": {
      "type": "object",
      "required": [
        "v",
        "running",
        "state"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "running": {
          "type": "boolean"
        },
        "state": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "pid",
            "session_id"
          ],
          "properties": {
            "pid": {
              "type": [
                "integer",
                "null"
              ]
            },
            "session_id": {
              "type": [
                "integer",
                "null"
              ]
            },
            "profit": {
              "type": [
                "number",
                "null"
              ]
            },
            "total_bets": {
              "type": [
                "integer",
                "null"
              ]
            },
            "uptime_sec": {
              "type": [
                "number",
                "null"
              ]
            },
            "bets_per_second": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "additionalProperties": true,
          "description": "The lane's state file exactly as the daemon writes it (no secrets in it)."
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": [
        "v",
        "error"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "enum": [
                "no_session",
                "state_unreadable"
              ]
            },
            "message": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
