# For a plain `docker compose` run copy to deploy/.env (git-ignored); on Coolify, deploy/install.sh
# prints these values to paste into the resource. No secrets here: they live in deploy/secrets/.

# Public hostname Caddy gets a TLS certificate for, one per service.
WOLFBET_HOST=wolfbet.example.com

# Directory that holds the bot's SQLite database, mounted read-only into ingest.
BOT_DATA_DIR=/root
# The Telegram bot's data dir as ingest sees it (inside BOT_DATA_DIR, which is mounted at /botdata),
# e.g. /botdata/.wolfbot_tg; blank leaves Telegram users out of history.
INGEST_TG_DATA_DIR=
# Live per-user topics for the Telegram bot (wolfbet-tg) next to the daemon's; blank leaves them off.
LIVE_USER_SERVICE=

# Time zone of the bot's host (the bot writes local times), e.g. Europe/Berlin. Check with: timedatectl
HOST_TZ=UTC

# Host control agent (agent/install.sh): the api joins its group to reach the socket.
# AGENT_GID: getent group casino-agent | cut -d: -f3
AGENT_GID=
AGENT_RUNTIME_DIR=/run/user/0/casino-agent

COMPOSE_PROJECT_NAME=wolfbet-dashboard

# Sender address for invites, password resets and notices. Its domain must be verified in Brevo.
MAIL_FROM=no-reply@example.com
# The alert bot's @username (no token here), for the "Link Telegram" button; blank hides it.
TELEGRAM_BOT_USERNAME=
# The push public key (see deploy/README.md); blank keeps push notifications off.
VAPID_PUBLIC_KEY=
# Networks the web terminal may be opened from, e.g. 203.0.113.0/24,2001:db8::/32; blank allows any.
TERMINAL_IP_ALLOWLIST=

# Secrets: one value per file, mode 600, generated once on the server:
#   mkdir -p deploy/secrets && chmod 700 deploy/secrets
#   for s in session_secret totp_key postgres_password postgres_app_password redis_publisher_password redis_dashboard_password; do
#     openssl rand -base64 36 | tr -d '\n' > deploy/secrets/$s.txt
#     chmod 644 deploy/secrets/$s.txt
#   done
# Plus the Brevo API key, copied from Brevo: deploy/secrets/brevo_api_key.txt
# Plus the alert bot's token from @BotFather (a bot of its own, not the wolfbet TG bot):
#   deploy/secrets/telegram_bot_token.txt; leave the file empty to keep Telegram alerts off
# Plus the push signing key: deploy/secrets/vapid_private_key.txt (README); empty keeps push off
# Plus the agent token, copied from the agent: install -m 644 ~/.config/casino-agent/token deploy/secrets/agent_token.txt
# Absolute path of the secrets directory, so a deploy from Coolify's own clone finds them.
SECRETS_DIR=/root/casino-dashboard/deploy/secrets
# Where Caddy listens: ":80" behind Coolify's proxy (TLS ends there).
CADDY_ADDRESS=:80
