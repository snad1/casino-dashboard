# Copy to deploy/.env (git-ignored) and fill in. No secrets here: they live in deploy/secrets/.

# Public hostname Caddy gets a TLS certificate for, one per service.
WOLFBET_HOST=wolfbet.example.com

# Directory that holds the bot's SQLite database, mounted read-only into ingest.
BOT_DATA_DIR=/root

# Time zone of the bot's host (the bot writes local times), e.g. Europe/Berlin. Check with: timedatectl
HOST_TZ=UTC

# Host control agent (agent/install.sh): the api joins its group to reach the socket.
# AGENT_GID: getent group casino-agent | cut -d: -f3
AGENT_GID=
AGENT_RUNTIME_DIR=/run/user/0/casino-agent

COMPOSE_PROJECT_NAME=wolfbet-dashboard

# Sender address for invites, password resets and notices. Its domain must be verified in Brevo.
MAIL_FROM=no-reply@example.com

# Secrets: one value per file, mode 600, generated once on the server:
#   mkdir -p deploy/secrets && chmod 700 deploy/secrets
#   for s in session_secret totp_key postgres_password postgres_app_password redis_publisher_password redis_dashboard_password; do
#     openssl rand -base64 36 | tr -d '\n' > deploy/secrets/$s.txt
#     chmod 644 deploy/secrets/$s.txt
#   done
# Plus the Brevo API key, copied from Brevo: deploy/secrets/brevo_api_key.txt
# Plus the agent token, copied from the agent: install -m 644 ~/.config/casino-agent/token deploy/secrets/agent_token.txt
