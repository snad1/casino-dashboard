{
	admin off
	# Coolify's proxy sits in front: keep the client address it forwards.
	servers {
		trusted_proxies static private_ranges
	}
}

# Liveness for the container healthcheck; this port is not published.
http://:2020 {
	respond /health 200
}

{$CADDY_ADDRESS::80} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' wss:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# Metrics are for inside the stack only.
	respond /api/metrics 404

	handle_path /api/* {
		reverse_proxy api:8000
	}

	handle /ws* {
		reverse_proxy api:8000
	}

	# The worker must be checked on every visit so a deploy reaches installed apps.
	header /service-worker.js Cache-Control "no-cache"
	header /manifest.webmanifest Content-Type "application/manifest+json"

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
