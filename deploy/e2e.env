# Throwaway end-to-end stack (tools/e2e_stack.sh). No secrets here; they are generated into
# deploy/e2e-secrets/ on each run and removed with the stack.
COMPOSE_PROJECT_NAME=wolfbet-e2e
WOLFBET_HOST=localhost
CADDY_ADDRESS=localhost
BOT_DATA_DIR=./e2e-botdata
HOST_TZ=UTC
AGENT_GID=0
AGENT_RUNTIME_DIR=./e2e-agent
MAIL_FROM=no-reply@example.test
